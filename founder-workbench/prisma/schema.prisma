// Founder Workbench data model.
//
// Provider is SQLite for local dev. For deploy, switch to:
//   provider = "postgresql"
// and point DATABASE_URL at Neon/Postgres. Every "enum" here is stored as a
// String and validated in app code (src/lib/types.ts) because SQLite does not
// support Prisma enums; array-shaped fields are stored as Json for the same
// reason. This keeps ONE schema working on both engines.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) adapter models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  ventures          Venture[]
  constraintProfile ConstraintProfile?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

/// One per user — the ruleset every idea is tested against.
model ConstraintProfile {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  capitalAvailable         Int // USD
  hoursPerWeek             Int
  monthsUntilRevenueNeeded Int
  riskTolerance            String // LOW | MEDIUM | HIGH
  // The next three are JSON-encoded string[] stored as text: SQLite's Prisma
  // connector supports neither enums nor scalar arrays nor Json. asStringArray()
  // in src/lib/types.ts decodes them. On Postgres these can become Json/String[].
  accessAssets             String @default("[]")
  toleranceProfile         String @default("[]")
  hardExclusions           String @default("[]")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One business idea.
model Venture {
  id           String    @id @default(cuid())
  userId       String
  title        String
  oneLiner     String
  status       String    @default("ACTIVE") // ACTIVE | PARKED | KILLED | LAUNCHED
  currentStage String    @default("KILL_CRITERIA") // see src/lib/stages.ts
  killReason   String?
  killedAt     DateTime?
  parkReason   String?
  fitReason    String? // why this idea fit THIS user's constraints (from intake)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  killCriteria   KillCriterion[]
  evidence       EvidenceEntry[]
  assumptions    Assumption[]
  decisionLog    DecisionLogEntry[]
  offer          Offer?

  @@index([userId])
}

/// Written BEFORE research begins, per venture. Prevents sunk-cost attachment.
model KillCriterion {
  id            String   @id @default(cuid())
  ventureId     String
  statement     String
  isFalsifiable Boolean  @default(false)
  isTriggered   Boolean  @default(false)
  triggeredNote String?
  createdAt     DateTime @default(now())

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId])
}

/// The heart of the app. Append-only in practice (no edit/delete server actions).
model EvidenceEntry {
  id          String   @id @default(cuid())
  ventureId   String
  type        String // CONVERSATION | PRICE_TEST | COMPETITOR | PUBLIC_DATA | PREORDER | OTHER
  source      String // who or what; for CONVERSATION a real person's name/role
  date        DateTime
  claimTested String // the assumption this was meant to check
  finding     String // what actually happened, user's own words
  verdict     String // SUPPORTS | CONTRADICTS | INCONCLUSIVE
  assumptionId String?
  createdAt   DateTime @default(now())

  venture    Venture     @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  assumption Assumption? @relation(fields: [assumptionId], references: [id], onDelete: SetNull)

  @@index([ventureId])
}

/// Extracted from the idea, ranked by risk.
model Assumption {
  id        String   @id @default(cuid())
  ventureId String
  statement String
  riskLevel String // FATAL | SERIOUS | MINOR
  status    String   @default("UNTESTED") // UNTESTED | TESTING | SUPPORTED | REFUTED
  createdAt DateTime @default(now())

  venture  Venture         @relation(fields: [ventureId], references: [id], onDelete: Cascade)
  evidence EvidenceEntry[]

  @@index([ventureId])
}

/// Append-only. Never edit or delete. The log is what makes the app worth returning to.
model DecisionLogEntry {
  id        String   @id @default(cuid())
  ventureId String
  stage     String
  decision  String
  reasoning String
  createdAt DateTime @default(now())

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)

  @@index([ventureId])
}

/// Stage 6 artifact.
model Offer {
  id            String   @id @default(cuid())
  ventureId     String   @unique
  whoItsFor     String
  problemSolved String
  deliverable   String
  price         String
  guarantee     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  venture Venture @relation(fields: [ventureId], references: [id], onDelete: Cascade)
}
