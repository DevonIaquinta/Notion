# ---------------------------------------------------------------------------
# Founder Workbench environment
# Copy to .env for local development.
# ---------------------------------------------------------------------------

# Database. SQLite for local dev; swap the provider in prisma/schema.prisma to
# "postgresql" and point this at Neon/Postgres for deploy.
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-please-32-bytes-min"
# Optional in dev — falls back to http://localhost:3000
# AUTH_URL="http://localhost:3000"

# Magic-link email delivery. If EMAIL_SERVER is unset, dev mode prints the
# sign-in link to the server console instead of sending mail (no SMTP needed).
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="Founder Workbench <no-reply@localhost>"

# Anthropic — server-side only. NEVER expose this to the client.
ANTHROPIC_API_KEY=""
# Model id is configurable. The spec names claude-sonnet-4-6; set whatever
# model your account has access to here.
ANTHROPIC_MODEL="claude-sonnet-4-5"

# One-click demo sign-in (no email). Set to "1" to show an "Enter the workbench"
# button on the sign-in page and let it create a session directly. WARNING: when
# on, anyone who can reach the URL can sign in as any address — use it only for a
# private hosted demo you don't share widely. Leave blank to require magic-link.
ALLOW_DEMO_LOGIN=""
